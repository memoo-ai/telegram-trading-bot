generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 新增表
model exchange_rate {
  id          String   @id @default(uuid())
  solToUsdt   Decimal  @db.Decimal(10, 6)
  usdtToSol   Decimal  @db.Decimal(10, 6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  
  @@map("memoo_exchange_rate")
}

model bot_users {
  id            String    @id @default(uuid())
  tgId          BigInt    @unique
  isBot         Boolean?
  username      String?   @db.VarChar(100)
  firstName     String?   @db.VarChar(100)
  lastName      String?   @db.VarChar(100)
  inviteCode    String    @db.VarChar(50)
  referralCode  String    @db.VarChar(50)
  agreedToTerms Boolean   @default(false)
  totalInvites  Int       @default(0)
  created_at    DateTime? @db.Timestamptz(6)
  updated_at    DateTime? @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)
  wallets       bot_wallets[]
  deleted_wallets bot_delete_wallets[]

  @@index([deleted_at], map: "idx_bot_users_deleted_at")
  @@map("memoo_bot_users")
}

model bot_wallets {
  id                 String    @id @default(uuid())
  walletName         String    @db.VarChar(100)
  walletAddress      String    @db.VarChar(255)
  walletPrivateKey   String    @db.Text
  isDefaultWallet    Boolean   @default(false)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)
  balance            Decimal   @default(0) @db.Decimal(30, 18)
  balanceUsd         Decimal   @default(0) @db.Decimal(30, 18)
  user_id            String
  user               bot_users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at         DateTime? @db.Timestamptz(6)
  deleted_at         DateTime? @db.Timestamptz(6)

  @@unique([user_id, walletAddress])
  @@index([user_id], map: "idx_bot_wallets_user_id")
  @@index([deleted_at], map: "idx_bot_wallets_deleted_at")
  @@map("memoo_bot_wallets")
}

model bot_delete_wallets {
  id                 String    @id @default(uuid())
  originalWalletId   String    @db.Uuid
  walletName         String    @db.VarChar(100)
  walletAddress      String    @db.VarChar(255)
  walletPrivateKey   String    @db.Text
  isDefaultWallet    Boolean   @default(false)
  deleted_at         DateTime  @default(now()) @db.Timestamptz(6)
  originalCreatedAt  DateTime  @db.Timestamptz(6)
  balance            Decimal   @default(0) @db.Decimal(30, 18)
  balanceUsd         Decimal   @default(0) @db.Decimal(30, 18)
  user_id            String
  user               bot_users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, walletAddress])
  @@index([user_id], map: "idx_bot_delete_wallets_user_id")
  @@index([deleted_at], map: "idx_bot_delete_wallets_deleted_at")
  @@map("memoo_bot_delete_wallets")
}


